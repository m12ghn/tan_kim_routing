# Chạy thử cục bộ: copy thành .env (KHÔNG commit). Trên Vercel đặt ở Settings → Environment Variables.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# ---- Chỉ server (api/*.js). Không bao giờ nhúng vào giao diện. ----
SUPABASE_SERVICE_ROLE_KEY=
# Tài khoản dịch vụ Google (chỉ cần quyền Xem sheet "Data xe")
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Không bắt buộc: mặc định là sheet "M12 Data bot btbd 1"
VEHICLE_SHEET_ID=
# Chuỗi ngẫu nhiên để Vercel Cron gọi đồng bộ xe mỗi sáng
CRON_SECRET=
